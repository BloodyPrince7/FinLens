# Convai Character ID for the plain REST Character API
# (https://api.convai.com/character/getResponse). This is what powers the
# text/voice conversation - it has no domain-whitelisting requirement, so it
# works unmodified on http://localhost:5173 or any other origin.
#
# The API key is only ever read server-side, inside vite.config.js's dev
# middleware (see convaiCharacterProxy) - it is never bundled into the
# browser-facing JS, so it stays out of devtools/source for this call.
VITE_CONVAI_API_KEY=your_convai_api_key_here
VITE_CONVAI_CHARACTER_ID=your_character_id_here
