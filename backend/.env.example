# FinLens AI - Backend Environment Configuration

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model (e.g., gemini-3.6-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-3.6-flash

# Allowed Frontend Origins for CORS (comma-separated)
FRONTEND_URL=https://www.arvronline.in,https://arvronline.in,https://fin-lens-jyy5.vercel.app,http://localhost:5173