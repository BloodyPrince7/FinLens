# FinLens AI - Backend Environment Configuration

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model (e.g., gemini-3.6-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-3.6-flash

# Allowed Frontend Origins for CORS (comma-separated)
FRONTEND_URL=https://www.arvronline.in,https://arvronline.in,https://fin-lens-jyy5.vercel.app,http://localhost:5173

# Cognee - AI memory/knowledge-graph layer (cross-document financial retrieval).
# Set COGNEE_ENABLED=false to disable the feature entirely - the rest of the
# app (upload, OCR, chat) keeps working without it.
COGNEE_ENABLED=true

# COGNEE_MODE=local (default): everything stays on this machine, reusing
# GEMINI_API_KEY above for both LLM reasoning and embeddings - no second key
# needed. Leave COGNEE_CLOUD_URL blank in this mode.
#
# COGNEE_MODE=cloud: connects to a Cognee Cloud tenant instead (an external
# service) - requires COGNEE_CLOUD_URL (from your Cognee Cloud console, e.g.
# https://your-tenant.aws.cognee.ai) and COGNEE_API_KEY.
COGNEE_MODE=local
COGNEE_CLOUD_URL=
COGNEE_API_KEY=
COGNEE_LLM_PROVIDER=gemini
COGNEE_LLM_MODEL=gemini-3.5-flash-lite
COGNEE_EMBEDDING_PROVIDER=gemini
COGNEE_EMBEDDING_MODEL=gemini-embedding-001
COGNEE_EMBEDDING_DIMENSIONS=3072
COGNEE_DATA_PATH=data/cognee_storage